<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernPersianDatePicker;assembly=ModernPersianDatePicker">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ModernPersianDatePicker/Themes/PersianDatePickerColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ModernPersianDatePicker Style -->
    <Style Selector="local|ModernPersianDatePicker">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Display Text (non-editable mode) -->
                        <TextBlock x:Name="PART_DisplayText"
                                   Grid.Column="0"
                                   Text="Select date..."
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   Foreground="{DynamicResource PersianDatePickerTextForegroundBrush}"/>

                        <!-- Editable TextBox -->
                        <TextBox x:Name="PART_EditableText"
                                 Grid.Column="0"
                                 Text=""
                                 VerticalAlignment="Center"
                                 Margin="4,0"
                                 Padding="8,4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsVisible="False"/>

                        <!-- Toggle Button -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Grid.Column="1"
                                      Width="30"
                                      Height="24"
                                      Margin="0,0,4,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      ClickMode="Press">
                            <PathIcon Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M16,17H18V15H16M13,17H15V15H13M10,17H12V15H10M7,17H9V15H7M16,14H18V12H16M13,14H15V12H13M10,14H12V12H10M7,14H9V12H7M16,11H18V9H16M13,11H15V9H13M10,11H12V9H10M7,11H9V9H7M19,7H5V5H19V7Z"
                                      Width="16"
                                      Height="16"/>
                        </ToggleButton>

                        <!-- Popup -->
                        <Popup x:Name="PART_Popup"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               PlacementTarget="{TemplateBinding}"
                               Placement="Bottom"
                               IsOpen="False"
                               IsLightDismissEnabled="True"
                               HorizontalOffset="-1">
                            <Border Background="{DynamicResource PersianDatePickerPopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource PersianDatePickerPopupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    BoxShadow="0 4 8 0 #40000000"
                                    MinWidth="280">
                                <StackPanel>
                                    <local:CalendarView x:Name="PART_CalendarView"/>
                                    <local:TimePickerView x:Name="PART_TimePickerView"
                                                          IsVisible="False"
                                                          Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hover state -->
    <Style Selector="local|ModernPersianDatePicker:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerFocusBorderBrush}"/>
    </Style>

    <!-- Focused state -->
    <Style Selector="local|ModernPersianDatePicker:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerFocusBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Focused with popup open -->
    <Style Selector="local|ModernPersianDatePicker:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerFocusBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Watermark style -->
    <Style Selector="local|ModernPersianDatePicker TextBlock.watermark">
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerWatermarkForegroundBrush}"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>

    <!-- CalendarView Style -->
    <Style Selector="local|CalendarView">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerPopupBackgroundBrush}"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="MinHeight" Value="300"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Header with navigation buttons -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                            <Button x:Name="PART_PreviousButton"
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Left"
                                    Focusable="False">
                                <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                          Width="16"
                                          Height="16"/>
                            </Button>

                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto">
                                <Button x:Name="PART_MonthButton"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Classes="month-year-button">
                                    <TextBlock x:Name="PART_MonthText"
                                               Text="Month"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                </Button>

                                <Button x:Name="PART_TodayButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Classes="month-year-button"
                                        ToolTip.Tip="Go to today">
                                    <StackPanel Orientation="Horizontal">
                                        <PathIcon Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M16,17H18V15H16M13,17H15V15H13M10,17H12V15H10M7,17H9V15H7M16,14H18V12H16M13,14H15V12H13M10,14H12V12H10M7,14H9V12H7M16,11H18V9H16M13,11H15V9H13M10,11H12V9H10M7,11H9V9H7M19,7H5V5H19V7Z"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0"/>
                                        <TextBlock x:Name="PART_TodayText"
                                                   Text="Today"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="PART_YearButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Classes="month-year-button">
                                    <TextBlock x:Name="PART_YearText"
                                               Text="Year"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Button x:Name="PART_NextButton"
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Focusable="False">
                                <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Width="16"
                                          Height="16"/>
                            </Button>
                        </Grid>

                        <!-- Month selection popup -->
                        <Popup x:Name="PART_MonthPopup"
                               Placement="Bottom"
                               IsOpen="False"
                               IsLightDismissEnabled="True"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource PersianDatePickerPopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource PersianDatePickerPopupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    BoxShadow="0 4 8 0 #40000000"
                                    Padding="8">
                                <Grid x:Name="PART_MonthGrid"
                                      ColumnDefinitions="*,*,*"
                                      MaxWidth="200"/>
                            </Border>
                        </Popup>

                        <!-- Year selection popup -->
                        <Popup x:Name="PART_YearPopup"
                               Placement="Bottom"
                               IsOpen="False"
                               IsLightDismissEnabled="True"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource PersianDatePickerPopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource PersianDatePickerPopupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    BoxShadow="0 4 8 0 #40000000"
                                    Padding="8">
                                <Grid x:Name="PART_YearGrid"
                                      ColumnDefinitions="*,*,*"
                                      MaxWidth="200"/>
                            </Border>
                        </Popup>

                        <!-- Days grid -->
                        <Grid x:Name="PART_DaysGrid"
                              Grid.Row="1"
                              Margin="0,4"/>

                        <!-- Today button placeholder -->
                        <Border Grid.Row="2" Margin="0,8,0,0"/>

                        <!-- Quick Range Button (visible only in range mode) -->
                        <Button x:Name="PART_QuickRangeButton"
                                Grid.Row="2"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                Focusable="False"
                                IsVisible="False"
                                Classes="month-year-button">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,10H16V14H12V10M10,10H6V14H10V10Z"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,4,0"/>
                                <TextBlock x:Name="PART_QuickRangeText"
                                           Text="Quick Range"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Quick Range View (hidden by default) -->
                        <local:QuickRangeView x:Name="PART_QuickRangeView"
                                              Grid.Row="0"
                                              Grid.RowSpan="3"
                                              IsVisible="False"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Day header style -->
    <Style Selector="local|CalendarView TextBlock.day-header">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerHeaderForegroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Day button style -->
    <Style Selector="local|CalendarView Button.day-button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerDayForegroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="True"/>
    </Style>

    <!-- Day button hover style -->
    <Style Selector="local|CalendarView Button.day-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerDayHoverBackgroundBrush}"/>
    </Style>

    <!-- Selected day button style -->
    <Style Selector="local|CalendarView Button.day-button.selected">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerSelectedForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Selected day button hover style -->
    <Style Selector="local|CalendarView Button.day-button.selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerAccentHoverBrush}"/>
    </Style>

    <!-- Today day button style -->
    <Style Selector="local|CalendarView Button.day-button.today">
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerAccentBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Month/Year button style -->
    <Style Selector="local|CalendarView Button.month-year-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="local|CalendarView Button.month-year-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerMonthYearHoverBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="local|CalendarView Button.month-year-button.selected">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerSelectedForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Day button focus style -->
    <Style Selector="local|CalendarView Button.day-button:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerFocusBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerDayFocusBackgroundBrush}"/>
    </Style>

    <!-- Focused and selected day button style -->
    <Style Selector="local|CalendarView Button.day-button.selected:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerSelectedFocusBorderBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerSelectedFocusBackgroundBrush}"/>
    </Style>

    <!-- Holiday day button style.
    Ordered AFTER .selected/.selected:focus so a holiday keeps its red foreground
    even when selected/focused (holiday wins per requirement). -->
    <Style Selector="local|CalendarView Button.day-button.holiday">
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerHolidayForegroundBrush}"/>
    </Style>
    <Style Selector="local|CalendarView Button.day-button.holiday.selected">
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerHolidayForegroundBrush}"/>
    </Style>
    <Style Selector="local|CalendarView Button.day-button.holiday.selected:focus">
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerHolidayForegroundBrush}"/>
    </Style>
    <Style Selector="local|CalendarView Button.day-button.holiday:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerHolidayForegroundBrush}"/>
    </Style>

    <!-- Range styles -->
    <Style Selector="local|CalendarView Button.day-button.in-range">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerDayHoverBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="local|CalendarView Button.day-button.range-start">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerSelectedForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CornerRadius" Value="18,4,4,18"/>
    </Style>
    <Style Selector="local|CalendarView Button.day-button.range-end">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PersianDatePickerSelectedForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CornerRadius" Value="4,18,18,4"/>
    </Style>
    <Style Selector="local|CalendarView Button.day-button.range-start:pointerover">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerAccentHoverBrush}"/>
    </Style>
    <Style Selector="local|CalendarView Button.day-button.range-end:pointerover">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerAccentHoverBrush}"/>
    </Style>

    <!-- TimePickerView style -->
    <Style Selector="local|TimePickerView">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal"
                            Spacing="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- Hour -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <RepeatButton x:Name="PART_HourDown"
                                      Content="-"
                                      Width="24" Height="28"
                                      Focusable="False"
                                      FontSize="14"/>
                        <TextBox x:Name="PART_HourBox"
                                 Text="00"
                                 FontSize="14" FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center"
                                 Width="36" Height="28"
                                 Padding="4,2"
                                 CornerRadius="2"
                                 Background="{DynamicResource PersianDatePickerDayHoverBackgroundBrush}"
                                 Foreground="{DynamicResource PersianDatePickerDayForegroundBrush}"/>
                        <RepeatButton x:Name="PART_HourUp"
                                      Content="+"
                                      Width="24" Height="28"
                                      Focusable="False"
                                      FontSize="14"/>
                    </StackPanel>

                    <TextBlock Text=":"
                               VerticalAlignment="Center"
                               FontSize="16" FontWeight="Bold"
                               Margin="2,0"
                               Foreground="{DynamicResource PersianDatePickerDayForegroundBrush}"/>

                    <!-- Minute -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <RepeatButton x:Name="PART_MinuteDown"
                                      Content="-"
                                      Width="24" Height="28"
                                      Focusable="False"
                                      FontSize="14"/>
                        <TextBox x:Name="PART_MinuteBox"
                                 Text="00"
                                 FontSize="14" FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center"
                                 Width="36" Height="28"
                                 Padding="4,2"
                                 CornerRadius="2"
                                 Background="{DynamicResource PersianDatePickerDayHoverBackgroundBrush}"
                                 Foreground="{DynamicResource PersianDatePickerDayForegroundBrush}"/>
                        <RepeatButton x:Name="PART_MinuteUp"
                                      Content="+"
                                      Width="24" Height="28"
                                      Focusable="False"
                                      FontSize="14"/>
                    </StackPanel>

                    <TextBlock Text=":"
                               VerticalAlignment="Center"
                               FontSize="16" FontWeight="Bold"
                               Margin="2,0"
                               Foreground="{DynamicResource PersianDatePickerDayForegroundBrush}"/>

                    <!-- Second -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <RepeatButton x:Name="PART_SecondDown"
                                      Content="-"
                                      Width="24" Height="28"
                                      Focusable="False"
                                      FontSize="14"/>
                        <TextBox x:Name="PART_SecondBox"
                                 Text="00"
                                 FontSize="14" FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center"
                                 Width="36" Height="28"
                                 Padding="4,2"
                                 CornerRadius="2"
                                 Background="{DynamicResource PersianDatePickerDayHoverBackgroundBrush}"
                                 Foreground="{DynamicResource PersianDatePickerDayForegroundBrush}"/>
                        <RepeatButton x:Name="PART_SecondUp"
                                      Content="+"
                                      Width="24" Height="28"
                                      Focusable="False"
                                      FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- QuickRangeView style -->
    <Style Selector="local|QuickRangeView">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerPopupBackgroundBrush}"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- Row 1: From/To DatePickers + Apply -->
                        <StackPanel x:Name="PART_Row1Panel"
                                    Grid.Row="0"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                            <local:ModernPersianDatePicker x:Name="PART_FromPicker"
                                                           MinWidth="120"
                                                           Watermark="From..."/>
                            <TextBlock Text="~"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="4,0"
                                       Foreground="{DynamicResource PersianDatePickerDayForegroundBrush}"/>
                            <local:ModernPersianDatePicker x:Name="PART_ToPicker"
                                                           MinWidth="120"
                                                           Watermark="To..."/>
                            <Button x:Name="PART_ApplyButton"
                                    Classes="qr-button"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Apply"
                                           FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>

                        <!-- Row 2: Preset Buttons -->
                        <StackPanel x:Name="PART_Row2Panel"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                            <Button x:Name="PART_TodayButton"
                                    Classes="qr-button"
                                    Padding="8,6"
                                    MinWidth="70">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M16,17H18V15H16M13,17H15V15H13M10,17H12V15H10M7,17H9V15H7M16,14H18V12H16M13,14H15V12H13M10,14H12V12H10M7,14H9V12H7M16,11H18V9H16M13,11H15V9H13M10,11H12V9H10M7,11H9V9H7M19,7H5V5H19V7Z"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,4,0"/>
                                    <TextBlock Text="Today"
                                               FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PART_WeekButton"
                                    Classes="qr-button"
                                    Padding="8,6"
                                    MinWidth="70">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M16,17H18V15H16M13,17H15V15H13M10,17H12V15H10M7,17H9V15H7"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,4,0"/>
                                    <TextBlock Text="Week"
                                               FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PART_MonthButton"
                                    Classes="qr-button"
                                    Padding="8,6"
                                    MinWidth="70">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="M19,3H18V1H16V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V8H19V19Z"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,4,0"/>
                                    <TextBlock Text="Month"
                                               FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PART_YearButton"
                                    Classes="qr-button"
                                    Padding="8,6"
                                    MinWidth="70">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2Zm0,18A8,8 0 1,1 20,12A8,8 0 0,1 12,20ZM12.5,7H11V13L16.2,16.2L17,14.9L12.5,12.2V7Z"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,4,0"/>
                                    <TextBlock Text="Year"
                                               FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Row 3: Group Selector + Expandable Content + Back Button -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Group Selector (Month/Season/Half-Year) -->
                            <StackPanel x:Name="PART_GroupSelectorPanel"
                                        Grid.Row="0"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button x:Name="PART_GroupMonthButton"
                                        Classes="qr-button-group"
                                        Padding="12,8"
                                        MinWidth="80"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Month"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="PART_GroupSeasonButton"
                                        Classes="qr-button-group"
                                        Padding="12,8"
                                        MinWidth="80"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Season"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="PART_GroupHalfYearButton"
                                        Classes="qr-button-group"
                                        Padding="12,8"
                                        MinWidth="80"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Half-Year"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>

                            <!-- Expandable Content -->
                            <Border x:Name="PART_GroupContentBorder"
                                    Grid.Row="1"
                                    IsVisible="False"
                                    VerticalAlignment="Center"
                                    Margin="0,4,0,0">
                                <StackPanel x:Name="PART_GroupContentPanel"
                                            HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Back Button (separate row) -->
                            <Button x:Name="PART_BackButton"
                                    Grid.Row="2"
                                    Classes="qr-button"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    IsVisible="False"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                                              Width="14"
                                              Height="14"
                                              Margin="0,0,4,0"/>
                                    <TextBlock Text="Back"
                                               FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Quick Range button style with border -->
    <Style Selector="local|QuickRangeView Button.qr-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="local|QuickRangeView Button.qr-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource PersianDatePickerMonthYearHoverBackgroundBrush}"/>
    </Style>

    <!-- Quick Range group button style (larger, with border) -->
    <Style Selector="local|QuickRangeView Button.qr-button-group">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PersianDatePickerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Info -->
    <PackageId>ModernPersianDatePicker</PackageId>
    <Version>2.0.0</Version>
    <Authors>Ramin Alirezaee</Authors>
    <!--<Company>Your Company</Company>-->
    <Product>ModernPersianDatePicker</Product>
    <Description>Modern Persian Date Picker control for Avalonia UI with Jalali/Shamsi calendar support. Features include RTL/LTR layouts, keyboard navigation, editable mode, month/year selection, and full Persian calendar calculations.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <PackageTags>avalonia;persian;jalali;shamsi;datepicker;calendar;rtl;farsi</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/raminmjj/ModernPersianDatePicker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/raminmjj/ModernPersianDatePicker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0 - Breaking change: replaced Hour/Minute/Second properties on ModernPersianDatePicker (and Hour/Minute/Second on TimePickerView) with a single SelectedTime / Time property of type TimeSpan. Adds range-mode time support via RangeStartTime/RangeEndTime and a Quick Range panel that exposes time spinners on its From/To pickers.</PackageReleaseNotes>
    
    <!-- Generate XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\ModernPersianDatePickerTheme.xaml" />
    <AvaloniaResource Include="Themes\PersianDatePickerColors.xaml" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

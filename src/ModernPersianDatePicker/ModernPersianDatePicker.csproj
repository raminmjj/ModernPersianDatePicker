<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- AOT & trimming compatibility: keeps analyzers always on (also enforced in CI builds) -->
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- NuGet Package Info -->
    <PackageId>ModernPersianDatePicker</PackageId>
    <Version>2.2.12</Version>
    <Authors>Ramin Alirezaee</Authors>
    <!--<Company>Your Company</Company>-->
    <Product>ModernPersianDatePicker</Product>
    <Description>Modern Persian Date Picker control for Avalonia UI with Jalali/Shamsi calendar support. Features include RTL/LTR layouts, keyboard navigation, editable mode, month/year selection, and full Persian calendar calculations.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <PackageTags>avalonia;persian;jalali;shamsi;datepicker;calendar;rtl;farsi</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/raminmjj/ModernPersianDatePicker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/raminmjj/ModernPersianDatePicker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.2.12 - The time section is always left-to-right (it inherited an RTL container's direction). The controls' looks are ControlThemes keyed by type (app styles override any setter, BasedOn works, subclasses get the look). The text box's padding / vertical alignment are bound to the picker's Padding / VerticalContentAlignment (new). Behaviour changes: no default MinWidth (was 200); focus changes the border colour only (no 2 px border); an editable picker is not focusable itself - FocusEditableText() focuses its text box. Theme="Light" in a Dark application is now light, and the C# copy of the Dark palette is gone. The calendar button has its own theme and a new PersianDatePickerIconForegroundBrush key; the popup is at least as wide as the field; new SelectedDateCalendar. 2.1.12 - Typed dates are never silently replaced: HasInvalidInput reports an invalid entry kept under InvalidValueAction.Keep, CommitText() parses the box on demand, and an empty box means no date under Keep and SetToNull (behaviour change: Keep used to keep the old date). Persian and Arabic-Indic digits are accepted. New calendar-neutral SelectedDateTime (DateTime?, two-way). Auto mode follows a runtime culture switch via the static NotifyCultureChanged() / RefreshCalendar(), and switching CalendarType converts from the calendar the values are actually in. 2.0.0 - Breaking change: replaced Hour/Minute/Second properties on ModernPersianDatePicker (and Hour/Minute/Second on TimePickerView) with a single SelectedTime / Time property of type TimeSpan. Adds range-mode time support via RangeStartTime/RangeEndTime and a Quick Range panel that exposes time spinners on its From/To pickers.</PackageReleaseNotes>
    
    <!-- Generate XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AssemblyVersion>2.2.12.0</AssemblyVersion>
    <FileVersion>2.2.12.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModernPersianDatePicker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\ModernPersianDatePickerTheme.xaml" />
    <AvaloniaResource Include="Themes\PersianDatePickerColors.xaml" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
